<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    result.fxml — [UC3 View result] Màn hình hiển thị kết quả sau khi thắng/thua
    Controller : com.example.memorycardflip.controller.ResultController
    UseCase    : UC-03 (View result - Xem kết quả ván chơi)
-->
<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.memorycardflip.controller.ResultController"
           styleClass="game-scene"
           stylesheets="@../styles/game.css">

    <VBox alignment="CENTER" spacing="24" maxWidth="500">
        <padding>
            <Insets top="40" right="32" bottom="40" left="32"/>
        </padding>

        <!-- [UC3] Tiêu đề kết quả (WIN / GAME OVER), style đổi theo trạng thái ván -->
        <Label fx:id="lblResultTitle"
               text="KẾT QUẢ"
               styleClass="result-title"
               maxWidth="Infinity"
               alignment="CENTER"/>

        <!-- [UC3 - nâng cấp] Đánh giá sao 1–5★ -->
        <Label fx:id="lblStarRating"
               text="☆☆☆☆☆"
               styleClass="star-rating"
               maxWidth="Infinity"
               alignment="CENTER"/>

        <!-- [UC3] Khung thống kê chi tiết lấy dữ liệu từ GameState trong ResultController -->
        <VBox spacing="16"
              alignment="CENTER"
              styleClass="stats-card">

            <!-- [UC3] Độ khó và kích thước lưới của ván vừa chơi -->
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="ĐỘ KHÓ" styleClass="stats-label" minWidth="100"/>
                <Label fx:id="lblDifficultyValue" text="Easy (4x4)" styleClass="stats-value"/>
            </HBox>

            <!-- [UC3] Điểm số cuối cùng -->
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="ĐIỂM SỐ" styleClass="stats-label" minWidth="100"/>
                <Label fx:id="lblScoreValue" text="0" styleClass="stats-value, stats-score"/>
            </HBox>

            <!-- [UC3] Tổng số lượt di chuyển/lật thẻ -->
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="SỐ LƯỢT" styleClass="stats-label" minWidth="100"/>
                <Label fx:id="lblMovesValue" text="0" styleClass="stats-value"/>
            </HBox>

            <!-- [UC12] Hiển thị thời gian còn lại sau khi timer dừng ở cuối ván -->
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="THỜI GIAN CÒN" styleClass="stats-label" minWidth="100"/>
                <Label fx:id="lblTimeRemainingValue" text="00:00" styleClass="stats-value, stats-time"/>
            </HBox>

            <!-- [UC3] Số cặp đã ghép trên tổng số cặp của độ khó -->
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="CẶP ĐÃ GHÉP" styleClass="stats-label" minWidth="100"/>
                <Label fx:id="lblPairsValue" text="0 / 0" styleClass="stats-value"/>
            </HBox>

            <!-- [UC3] High Score / Kỷ lục được cập nhật sau khi lưu điểm -->
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="KỶ LỤC MỚI" styleClass="stats-label" minWidth="100"/>
                <Label fx:id="lblNewHighScore" text="---" styleClass="stats-value, stats-highscore"/>
            </HBox>
        </VBox>

        <!-- [UC3] Thông báo tổng kết theo kết quả thắng/thua -->
        <Label fx:id="lblSummary"
               text=""
               styleClass="summary-text"
               wrapText="true"
               alignment="CENTER"/>

        <!-- [UC3 - nâng cấp] Gợi ý cải thiện thông minh -->
        <Label fx:id="lblTip"
               text=""
               styleClass="tip-text"
               wrapText="true"
               alignment="CENTER"/>

        <!-- [UC3][UC4] Các nút hành động sau khi xem kết quả -->
        <HBox alignment="CENTER" spacing="12">
            <!-- [UC4] Chơi lại cùng độ khó của ván vừa kết thúc -->
            <Button text="CHƠI LẠI"
                    onAction="#onUCRS02Replay"
                    styleClass="primary-btn"/>

            <!-- [UC4 - nâng cấp] Lên độ khó tiếp theo (progressive mode) -->
            <Button fx:id="btnNextLevel"
                    text="⬆ LÊN LEVEL"
                    onAction="#onUCRS04NextLevel"
                    styleClass="next-level-btn"/>

            <Button text="VỀ MENU"
                    onAction="#onUCRS03BackToMenu"
                    styleClass="secondary-btn"/>
        </HBox>
    </VBox>

</StackPane>
