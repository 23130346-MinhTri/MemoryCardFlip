<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    result.fxml — Màn hình hiển thị kết quả sau khi thắng/thua
    Controller : com.example.memorycardflip.controller.ResultController
    UseCase    : UC-06 (Kết thúc game & Kết quả)
-->
<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.memorycardflip.controller.ResultController"
           styleClass="game-scene"
           stylesheets="@../styles/game.css">

    <VBox alignment="CENTER" spacing="24" maxWidth="500">
        <padding>
            <Insets top="40" right="32" bottom="40" left="32"/>
        </padding>

        <!-- Tiêu đề kết quả (WIN / GAME OVER) -->
        <Label fx:id="lblResultTitle"
               text="KẾT QUẢ"
               styleClass="result-title"
               maxWidth="Infinity"
               alignment="CENTER"/>

        <!-- Khung thống kê chi tiết -->
        <VBox spacing="16"
              alignment="CENTER"
              styleClass="stats-card">

            <!-- Độ khó -->
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="ĐỘ KHÓ" styleClass="stats-label" minWidth="100"/>
                <Label fx:id="lblDifficultyValue" text="Easy (4x4)" styleClass="stats-value"/>
            </HBox>

            <!-- Điểm số -->
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="ĐIỂM SỐ" styleClass="stats-label" minWidth="100"/>
                <Label fx:id="lblScoreValue" text="0" styleClass="stats-value, stats-score"/>
            </HBox>

            <!-- Số lượt di chuyển -->
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="SỐ LƯỢT" styleClass="stats-label" minWidth="100"/>
                <Label fx:id="lblMovesValue" text="0" styleClass="stats-value"/>
            </HBox>

            <!-- Thời gian còn lại -->
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="THỜI GIAN CÒN" styleClass="stats-label" minWidth="100"/>
                <Label fx:id="lblTimeRemainingValue" text="00:00" styleClass="stats-value, stats-time"/>
            </HBox>

            <!-- Số cặp đã ghép -->
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="CẶP ĐÃ GHÉP" styleClass="stats-label" minWidth="100"/>
                <Label fx:id="lblPairsValue" text="0 / 0" styleClass="stats-value"/>
            </HBox>

            <!-- High Score / Kỷ lục (sẽ được cập nhật sau khi lưu) -->
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="KỶ LỤC MỚI" styleClass="stats-label" minWidth="100"/>
                <Label fx:id="lblNewHighScore" text="---" styleClass="stats-value, stats-highscore"/>
            </HBox>
        </VBox>

        <!-- Thông báo tổng kết -->
        <Label fx:id="lblSummary"
               text=""
               styleClass="summary-text"
               wrapText="true"
               alignment="CENTER"/>

        <!-- Các nút hành động -->
        <HBox alignment="CENTER" spacing="20">
            <Button text="CHƠI LẠI"
                    onAction="#onUCRS02Replay"
                    styleClass="primary-btn"/>

            <Button text="VỀ MENU"
                    onAction="#onUCRS03BackToMenu"
                    styleClass="secondary-btn"/>
        </HBox>
    </VBox>

</StackPane>