<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.memorycardflip.controller.ResultController"
           styleClass="game-scene"
           stylesheets="@../styles/game.css">

    <VBox alignment="CENTER" spacing="18" maxWidth="420">
        <padding>
            <Insets top="36" right="28" bottom="36" left="28"/>
        </padding>

        <Label text="KET QUA VAN CHOI" styleClass="hud-label"/>

        <Label fx:id="lblResultTitle"
               text="YOU WIN"
               styleClass="result-win"
               maxWidth="Infinity"
               alignment="CENTER"/>

        <VBox spacing="12"
              alignment="CENTER"
              style="-fx-background-color: #162032; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: rgba(255,255,255,0.08); -fx-padding: 20;">

            <HBox alignment="CENTER_LEFT" spacing="16">
                <Label text="DO KHO" styleClass="hud-label"/>
                <Label fx:id="lblDifficultyValue" text="Easy 4x4" styleClass="hud-value"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="16">
                <Label text="DIEM" styleClass="hud-label"/>
                <Label fx:id="lblScoreValue" text="0" styleClass="hud-value hud-value-accent"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="16">
                <Label text="SO LUOT" styleClass="hud-label"/>
                <Label fx:id="lblMovesValue" text="0" styleClass="hud-value"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="16">
                <Label text="THOI GIAN CON" styleClass="hud-label"/>
                <Label fx:id="lblTimeValue" text="0s" styleClass="hud-value"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="16">
                <Label text="CAP DA GHEP" styleClass="hud-label"/>
                <Label fx:id="lblPairsValue" text="0 / 0" styleClass="hud-value"/>
            </HBox>
        </VBox>

        <Label fx:id="lblSummary"
               text="Ban da hoan thanh van choi."
               styleClass="status-text"
               wrapText="true"
               alignment="CENTER"/>

        <HBox alignment="CENTER" spacing="14">
            <Button text="CHOI LAI"
                    onAction="#onUCRS02Replay"
                    styleClass="restart-btn"/>

            <Button text="VE MENU"
                    onAction="#onUCRS03BackToMenu"
                    styleClass="back-btn"/>
        </HBox>
    </VBox>

</StackPane>
