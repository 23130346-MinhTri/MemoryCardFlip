<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.memorycardflip.controller.ComboNotificationController"
           styleClass="combo-notification-root"
           fx:id="rootPane"
        alignment="CENTER"
        prefWidth="9999"
        prefHeight="9999"
        maxWidth="Infinity"
        maxHeight="Infinity">

    <VBox alignment="CENTER" spacing="10" styleClass="combo-bubble" fx:id="bubblePane">
        <padding>
            <Insets top="18" right="24" bottom="18" left="24"/>
        </padding>

        <Label fx:id="lblSubText"
               text="STREAK BONUS"
               styleClass="combo-kicker"
               StackPane.alignment="CENTER"/>

        <HBox alignment="CENTER" spacing="12" styleClass="combo-main-row">
            <children>
                <Label fx:id="lblComboIcon"
                       text="🔥"
                       styleClass="combo-icon"
                       StackPane.alignment="CENTER"/>

                <Label fx:id="lblComboText"
                       text="x2"
                       styleClass="combo-text"
                       StackPane.alignment="CENTER"/>
            </children>
        </HBox>

        <Label fx:id="lblTagline"
               text="Bạn đang vào guồng"
               styleClass="combo-tagline"
               StackPane.alignment="CENTER"/>
    </VBox>

</StackPane>