<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<!--
    game.fxml — Màn hình chơi game chính
    Controller : com.example.memorycardflip.controller.GameController
    UseCase    : UC-01 (Khởi tạo), UC-02 (Lật thẻ), UC-03 (Kiểm tra), UC-04(Tiính điểm)
                 UC-12 (Count down timer - Đếm ngược thời gian), UC-07 (Đếm số & Dữ liệu)
    Updated    : Bổ sung Score, Moves, Time và ràng buộc dữ liệu
-->
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.memorycardflip.controller.GameController"
            styleClass="game-scene"
            stylesheets="@../styles/game.css">

    <!-- ══════════════════════════════════════
         TOP — HUD bar (Thanh thông tin chính)
         ══════════════════════════════════════ -->
    <top>
        <VBox fx:id="topBox">
            <HBox styleClass="hud-bar" alignment="CENTER" spacing="0">

                <!-- Độ khó -->
                <VBox styleClass="hud-group" alignment="CENTER" HBox.hgrow="ALWAYS">
                    <Label text="ĐỘ KHÓ" styleClass="hud-label"/>
                    <Label fx:id="lblDifficulty" text="Easy (4×4)" styleClass="hud-value"/>
                </VBox>

                <Separator orientation="VERTICAL" styleClass="hud-divider"/>

                <!-- Số cặp đã tìm (Matched Pairs) -->
                <VBox styleClass="hud-group" alignment="CENTER" HBox.hgrow="ALWAYS">
                    <Label text="ĐÃ KHỚP" styleClass="hud-label"/>
                    <Label fx:id="lblPairs" text="0 / 8 cặp" styleClass="hud-value"/>
                </VBox>

                <Separator orientation="VERTICAL" styleClass="hud-divider"/>

                <!-- Còn lại (Remaining Pairs) -->
                <VBox styleClass="hud-group" alignment="CENTER" HBox.hgrow="ALWAYS">
                    <Label text="CÒN LẠI" styleClass="hud-label"/>
                    <Label fx:id="lblRemaining" text="8" styleClass="hud-value, hud-value-remain"/>
                </VBox>

                <Separator orientation="VERTICAL" styleClass="hud-divider"/>

                <!-- ĐIỂM SỐ (Score) - Dữ liệu từ GameState -->
                <VBox styleClass="hud-group" alignment="CENTER" HBox.hgrow="ALWAYS">
                    <Label text="ĐIỂM" styleClass="hud-label"/>
                    <Label fx:id="lblScore" text="0" styleClass="hud-value, hud-value-accent"/>
                </VBox>

                <Separator orientation="VERTICAL" styleClass="hud-divider"/>

                <!-- SỐ LƯỢT (Moves) - Dữ liệu từ GameState -->
                <VBox styleClass="hud-group" alignment="CENTER" HBox.hgrow="ALWAYS">
                    <Label text="LƯỢT" styleClass="hud-label"/>
                    <Label fx:id="lblMoves" text="0" styleClass="hud-value"/>
                </VBox>

                <Separator orientation="VERTICAL" styleClass="hud-divider"/>

                <!-- [UC4] Nút chơi lại ngay trong màn chơi: reset board hiện tại -->
                <VBox styleClass="hud-group" alignment="CENTER">
                    <Button fx:id="btnRestart"
                            text="🔄 Chơi lại"
                            onAction="#handleUC01Restart"
                            styleClass="restart-btn"/>
                </VBox>

            </HBox>

            <!-- ══════════════════════════════════════
                 THANH THỜI GIAN & CẢNH BÁO
                 ══════════════════════════════════════ -->
            <!-- [UC12] Thời gian còn lại: label MM:SS và progress bar giảm dần theo timer -->
            <HBox styleClass="time-bar" alignment="CENTER_LEFT" spacing="10">
                <padding>
                    <Insets left="16" right="16"/>
                </padding>
                <Label text="⏱️ THỜI GIAN" styleClass="hud-label"/>
                <Label fx:id="lblTime" text="00:00" styleClass="time-value" HBox.hgrow="ALWAYS"/>
                <ProgressBar fx:id="timeProgressBar"
                             progress="1.0"
                             prefWidth="200"
                             prefHeight="10"
                             styleClass="time-progress"/>
            </HBox>
        </VBox>
    </top>

    <!-- ══════════════════════════════════════
         CENTER — Lưới thẻ bài (Card Grid)
         ══════════════════════════════════════ -->
    <center>
        <StackPane fx:id="gridWrapper" styleClass="grid-wrapper" alignment="CENTER">
            <GridPane fx:id="cardGrid"
                      styleClass="card-grid"
                      alignment="CENTER">
                <padding>
                    <Insets top="20" bottom="20" left="20" right="20"/>
                </padding>
            </GridPane>
        </StackPane>
    </center>

    <!-- ══════════════════════════════════════
         BOTTOM — Thanh trạng thái (Status Bar)
         ══════════════════════════════════════ -->
    <bottom>
        <VBox fx:id="bottomBox" spacing="8">
            <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="12">
                <padding>
                    <Insets top="8" bottom="8" left="16" right="16"/>
                </padding>

                <!-- Combo hiển thị (nếu có) và thông báo -->
                <Label fx:id="lblCombo" text="" styleClass="hud-combo-indicator"/>
                <Label fx:id="lblStatus"
                       text="Lật thẻ để bắt đầu!"
                       styleClass="status-text"
                       HBox.hgrow="ALWAYS"/>

                <Button text="← Menu"
                        onAction="#onBackToMenu"
                        styleClass="back-btn"/>
            </HBox>

            <HBox styleClass="footer-control-bar" alignment="CENTER_RIGHT" spacing="10">
                <padding>
                    <Insets top="6" bottom="10" left="16" right="16"/>
                </padding>
                <Button fx:id="btnHint"
                        text="💡 Gợi ý (3)"
                        onAction="#onHintClick"
                        styleClass="hint-btn"/>
                <Button fx:id="btnPause"
                        text="⏸ Tạm dừng"
                        onAction="#onTogglePause"
                        styleClass="pause-btn"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
