<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.memorycardflip.controller.GameController"
            styleClass="root-container game-scene"
            stylesheets="@../styles/game.css">

    <center>
        <StackPane>
            <padding>
                <Insets top="18" right="18" bottom="18" left="18"/>
            </padding>
            <GridPane fx:id="cardGrid" styleClass="card-grid" alignment="CENTER"/>
        </StackPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="16" styleClass="footer-row">
            <Button fx:id="btnRestart" text="Chơi lại" styleClass="footer-btn"/>
        </HBox>
    </bottom>

</BorderPane>
