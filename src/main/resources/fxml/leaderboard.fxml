<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.memorycardflip.controller.LeaderboardController"
      spacing="15"
      alignment="CENTER"
      styleClass="game-scene"
      stylesheets="@../styles/game.css">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="🏆 BẢNG XẾP HẠNG 🏆" styleClass="result-title"/>

    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="Chọn độ khó:" styleClass="stats-label"/>
        <ComboBox fx:id="comboDifficulty" prefWidth="120"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblTotalScores" styleClass="stats-value"/>
        <Label fx:id="lblBestScore" styleClass="stats-value stats-score"/>
    </HBox>

    <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colRank" text="#" prefWidth="50"/>
            <TableColumn fx:id="colPlayerName" text="Người chơi" prefWidth="150"/>
            <TableColumn fx:id="colDifficulty" text="Độ khó" prefWidth="100"/>
            <TableColumn fx:id="colScore" text="Điểm" prefWidth="80"/>
            <TableColumn fx:id="colMoves" text="Số lượt" prefWidth="80"/>
            <TableColumn fx:id="colTime" text="Thời gian dùng" prefWidth="100"/>
            <TableColumn fx:id="colDate" text="Ngày chơi" prefWidth="150"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER" spacing="20">
        <Button text="🔄 Làm mới" onAction="#onRefresh" styleClass="secondary-btn"/>
        <Button text="🗑️ Xóa tất cả" onAction="#onClearAll" styleClass="danger-btn"/>
        <Button text="← Quay lại" onAction="#onBackToMenu" styleClass="primary-btn"/>
    </HBox>

</VBox>